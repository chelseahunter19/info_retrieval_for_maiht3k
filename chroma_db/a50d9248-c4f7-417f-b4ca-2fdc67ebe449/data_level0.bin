h\"], [\"ed\"], [\"and\"], [\"\\\"\", \"ai\", \"\\\"\", \",\"], [\"again\"], [\"as\"], [\"if\"], [\"these\"], [\"two\"], [\"kind\"], [\"of\"], [\"human\"], [\"endeavor\"], [\"be\"], [\"in\"], [\"any\"], [\"way\"], [\"comparable\", \":\"], [\"high\"], [\"education\"], [\"and\"], [\"the\"], [\"field\"], [\"of\"], [\"artificial\"], [\"intelligence\", \",\"], [\"though\", \",\"], [\"be\"], [\"fundamentally\"], [\"mismatch\"], [\"in\"], [\"a\"], [\"number\"], [\"of\"], [\"way\", \".\"], [\"ai\"], [\"and\"], [\"genai\"], [\"technology\"], [\"be\"], [\"mature\"], [\"rapidly\", \",\"], [\"while\"], [\"college\"], [\"be\"], [\"historically\"], [\"slow\"], [\"to\"], [\"evolve\", \".\"], [\"institution\"], [\"have\"], [\"also\"], [\"traditionally\"], [\"tie\"], [\"much\"], [\"of\"], [\"their\"], [\"value\"], [\"to\"], [\"teach\"], [\"critical\"], [\"thinking\"], [\"and\"], [\"problem\"], [\"solve\"], [\"\\u2014\"], [\"skill\"], [\"that\", \",\", \"at\"], [], [\"face\"], [\"value\", \",\"], [\"be\"], [\"not\"], [\"synonymous\"], [\"with\"], [\"ai\", \",\"], [\"and\"], [\"that\"], [\"such\"], [\"technology\"], [\"could\"], [\"even\"], [\"impede\", \".\"], [\"this\"], [\"article\"], [\"also\"], [\"provide\"], [\"a\"], [\"nice\"], [\"compact\"], [\"illustration\"], [\"of\"], [\"two\"], [\"trope\"], [\"of\"], [\"ai\"], [\"hype\", \":\"], [\"that\"], [\"\\\"\", \"ai\", \"\\\"\"], [\"will\"], [\"solve\"], [\"all\"], [\"problem\"], [\"and\"], [\"that\"], [\"if\"], [\"we\"], [\"do\", \"not\"], [\"jump\"], [\"on\"], [\"board\", \",\"], [\"we\"], [\"(\", \"or\"], [\"here\", \",\"], [\"our\"], [\"student\", \")\"], [\"will\"], [\"be\"], [\"miss\"], [\"out\", \".\"], [\"ai\"], [\"hype\"], [\"be\"], [\"both\"], [\"tech\", \"-\", \"solutionism\"], [\"and\"], [\"fomo\", \":\"], [\"proponent\"], [\"of\"], [\"the\"], [\"continue\"], [\"integration\"], [\"of\"], [\"genai\"], [\"point\"], [\"out\"], [\"that\"], [\"these\"], [\"technology\"], [\"could\"], [\"be\"], [\"a\"], [\"lifeline\"], [\"for\