["watch"], ["and"], ["comment"], ["on"], ["the"], ["show"], ["while"], ["it", "be"], ["happen"], ["live"], ["on"], ["our"], ["twitch"], ["stream", "."], ["that", "be"], ["twitch.tv/dair_institute", "."], ["again", ","], ["that", "be"], ["dair_institute", ".", "I"], ["be"], ["emily"], ["m."], ["bender", "."], ["alex"], ["hanna", ":"], ["and"], ["I", "be"], ["alex"], ["hanna", "."], ["stay"], ["out"], ["of"], ["ai"], ["hell", ","], ["you", "all", "."]] ","], ["um", ","], ["doing"], ["pretty", ","], ["uh", ","], ["poorly"], ["on", ","], ["uh", ","], ["trans"], ["drivers", "."], ["um", ","], ["but"], ["i"], ["do", "n't"], ["think"], ["there", "'s"], ["been"], ["many", ",", "any"], [], ["accountability"], ["for"], ["them", ","], ["unfortunately", "."], ["yeah", "."], ["emily"], ["m."], ["bender", ":"], ["i"], ["think"], ["we"], ["got"], ["to"], ["celebrate"], ["the"], ["accountability"], ["as"], ["it"], ["comes"], ["in", ","], ["even"], ["while"], ["saying", ","], ["you"], ["know"], ["what", ","], ["uh", ","], ["dr", "."], ["gebru"], ["and"], ["dr", "."], ["buolamwini"], ["told"], ["you"], ["so", "."], ["alex"], ["hanna", ":"], ["yeah", ","], ["right", "."], ["emily"], ["m."], ["bender", ":"], ["that"], ["this"], ["was", "n't"], ["gon", "na"], ["work", "."], ["um", ","], ["so"], ["i", "'m", ",", "i", "'m"], [], ["glad"], ["to"], ["see"], ["the"], ["accountability", "."], ["alex"], ["hanna", ":"], ["yeah", "."], ["all"], ["right", "."], ["is"], ["that"], ["the"], ["end"], ["of"], ["it", "?"], ["emily"], ["m."], ["bender", ":"], ["uh", ","], ["well", ","], ["is"], ["that"], ["the"], ["end"], ["of"], ["it", "?"], ["that"], ["is"], ["not"], ["the"], ["end"], ["of"], ["it"], ["in"], ["the"], ["sense"], ["that"], ["when"], ["i"], ["selected"], ["these"], ["links"], ["this"], ["morning", ",", "i"], [], ["had", ","], ["i"], ["think"], ["at"], ["least"], ["this"], ["many", ","], ["again", ","], ["that"], ["did", "n't"], ["make"], ["it"], ["in"], ["because"], ["we"], ["are"], ["flooded"], ["continually"], ["with"], ["fresh"], ["ai"], ["hell", "."], ["but"], ["that", "'s"], ["the"], ["end"], ["of"], ["it"], ["for"], ["today", "."], ["except"], ["i"], ["think"], ["you", "'re"], ["promising"], ["me"], ["one"], ["last"], ["verse", "."], ["alex"], ["hanna", ":"], ["that", "'s"], ["right", "."], ["and"], ["it", "'s"], ["very", ","], ["it", ",", "it", ",", "it", ",", "it"], [], [], [], ["really"], ["matches"], ["the"], ["tone"], ["that"], ["we", "'re"], ["ending"], ["on", "."], ["(", "singing", ")"], ["we"], ["ride"], ["through"], ["the"], ["flood"], ["of"], ["such"], ["refuse"], ["and"], ["water", "."], ["the"], ["hype"], ["theater"], ["belt"], ["where"], ["we"], ["take"], ["on"], ["such"], ["slaughter", "."], ["slogging"], ["through"], ["bullshit", ","], ["we", "'ll"], ["never"], ["relax", ","], ["as"], ["shit"], ["talking"], ["ai"], ["is"], ["ridicule"], ["as"], ["praxis", "."], ["emily"], ["m."], ["bender", ":"], ["ridicule"], ["as"], ["praxis", ","], ["but"], ["sea"], ["shanty"], ["style", ","], ["which"], ["is"], ["so"], ["much"], ["better", "."], ["thank"], ["you"], ["for"], ["that", ","], ["alex", ","], ["and"], ["thank"], ["you"], ["to"], ["our"], ["amazing"], ["audience"], ["for"], ["sticking"], ["with"], ["us"], ["through"], ["this", ".", "i"], [], ["hope"], ["it", "'s"], ["been"], ["as"], ["cathartic"], ["for"], ["all"], ["of"], ["you"], ["as"], ["it"], ["has"], ["been"], ["for"], ["me", "."], ["alex"], ["hanna", ":"], ["ah", ","], ["such"], ["a"], ["great"], ["time", "."], ["that", "'s"], ["it"], ["for"], ["this"], ["week", "."], ["our"], ["theme"], ["song"], ["is"], ["by"], ["toby"], ["menon", ","], ["graphic"], ["design"], ["by"], ["naomi"], ["pleasure", "-", "park", "."], ["production"], ["by"], ["christie"], ["taylor"], ["and"], ["thanks"], ["as"], ["always"], ["to"], ["the"], ["distributed"], ["ai"], ["research"], ["institute", "."], ["if"], ["you"], ["like"], ["this"], ["show", ","], ["you"], ["can"], ["support"], ["us"], ["by"], ["rating"], ["and"], ["reviewing"], ["us"], ["on"], ["apple"], ["podcasts"], ["and"], ["spotify"], ["and"], ["by"], ["donating"], ["to"], ["dair"], ["at"], ["dair-institute.org", "."], ["that", "'s"], ["d"], ["a"], ["i"], ["r"], ["hyphen"], ["institute"], ["dot", "o"], [], ["r"], ["g."], ["emily"], ["m."], ["bender", ":"], ["find"], ["us"], ["and"], ["all"], ["our"], ["past"], ["episodes"], ["on"], ["peertube"], ["and"], ["wherever"], ["you"], ["get"], ["your"], ["podcasts", "."], ["you"], ["can"], ["watch"], ["and"], ["comment"], ["on"], ["the"], ["show"], ["while"], ["it", "'s"], ["happening"], ["live"], ["on"], ["our"], ["twitch"], ["stream", "."], ["that", "'s"], ["twitch.tv/dair_institute", "."], ["again"], ["that", "'s"], ["d"], ["a"], ["i"], ["r"], ["underscore"], ["institute", ".", "i"], ["'m"], ["emily"], ["m."], ["bender", "."], ["alex"], ["hanna", ":"], ["and"], ["i", "'m"], ["alex"], ["hanna", "."], ["stay"], ["out"], ["of"], ["ai"], ["hell", ","], ["you"], ["landlubbers", "."]] ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀["and"], ["with"], ["that"], ["we", "'re"], ["reaching"], ["the"], ["end"], ["of"], ["our"], ["time", "."], ["um"], ["thanks", "a"], [], ["lot"], ["everyone"], ["appreciate"], ["it"], ["uh"], ["yeah"], ["and"], ["we", "'ll"], ["catch"], ["you"], ["next"], ["time", "."], ["emily"], ["m."], ["bender", ":"], ["yeah", ","], ["hopefully"], ["soon", "."], ["but"], ["maybe"], ["the"], ["shitshow"], ["could"], ["slow"], ["down"], ["for"], ["a"], ["little"], ["bit"], ["and"], ["we"], ["could"], ["do"], ["our"], ["own"], ["work"], ["that"], ["would"], ["be"], ["nice", "."], ["alex"], ["hanna", ":"], ["i"], ["would"], ["love"], ["to"], ["breathe", "."], ["okay", ","], ["see"], ["you"], ["emily", ".", "emily"], [], ["m."], ["bender", ":"], ["bye", "."], ["alex", ":"], ["that", "\u2019s"], ["it"], ["for"], ["this"], ["week", "!"], ["our"], ["theme"], ["song"], ["is"], ["by"], ["toby"], ["men", "-", "en", "."], ["graphic"], ["design"], ["by"], ["naomi"], ["pleasure", "-", "park", "."], ["production"], ["by"], ["christie"], ["taylor", "."], ["and"], ["thanks", ","], ["as"], ["always", ","], ["to"], ["the"], ["distributed"], ["ai"], ["research"], ["institute", "."], ["if"], ["you"], ["like"], ["this"], ["show", ","], ["you"], ["can"], ["support"], ["us"], ["by"], ["rating"], ["and"], ["reviewing"], ["us"], ["on"], ["apple"], ["podcasts"], ["and"], ["spotify", "."], ["and"], ["by"], ["donating"], ["to"], ["dair"], ["at"], ["dair-institute.org", "."], ["that", "\u2019s"], ["d", "-", "a", "-", "i", "-", "r", ","], ["hyphen", ","], ["institute"], ["dot"], ["org", "."], ["emily", ":"], ["find"], ["us"], ["and"], ["all"], ["our"], ["past"], ["episodes"], ["on"], ["peertube", ","], ["and"], ["wherever"], ["you"], ["get"], ["your"], ["podcasts", "!"], ["you"], ["can"], ["watch"], ["and"], ["comment"], ["on"], ["the"], ["show"], ["while"], ["it", "\u2019s"], ["happening"], ["live"], ["on"], ["our"], ["twitch"], ["stream", ":"], ["that", "\u2019s"], ["twitch"], ["dot"], ["tv"], ["slash"], ["dair"], ["underscore"], ["institute", "\u2026", "again"], ["that", "\u2019s"], ["d", "-", "a", "-", "i", "-", "r"], ["underscore"], ["institute", ".", "i"], ["\u2019m"], ["emily"], ["m."], ["bender", "."], ["alex", ":"], ["and"], ["i", "\u2019m"], ["alex"], ["hanna", "."], ["stay"], ["out"], ["of"], ["ai"], ["hell", ","], ["y\u2019", "all", "."]]b␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀, "."], ["why", "?", "\""], ["and"], ["then"], ["in"], ["italics,\"well", ",", "it"], ["be"], ["the"], ["future", "."], ["what"], ["problem"], ["be"], ["it"], ["solve", "?", "\"", "in"], [], ["italics,\"well"], ["so"], ["far", ","], ["so"], ["far", ","], ["that", "be"], ["not"], ["clear", "."], ["be"], ["the"], ["customer"], ["demand"], ["it", "?"], ["lol", ","], ["no", ".", "\""], ["so", ","], ["yeah", "."], ["uh", ","], ["which"], ["be", ","], ["so"], ["it", "be"], ["pretty", ",", "pretty"], [], ["great", "."], ["and"], ["it", ","], ["uh", ","], ["reference"], ["that"], ["ad"], ["for"], ["the", ","], ["um", ","], ["the"], ["early"], ["ad"], ["for", ",", "for"], [], ["ai", ","], ["which"], ["be", ",", "I"], [], ["think"], ["it"], ["be"], ["not"], ["quite", ",", "I"], [], ["do", "not"], ["think"], ["it"], ["be"], ["for"], ["ai", ","], ["it"], ["be"], ["just"], ["the", ",", "the"], [], ["like"], ["ipad", "ad"], ["."], ["I", "be"], ["assume"], ["that", "be"], ["what"], ["the"], ["link"], ["be"], ["too", "."], ["emily"], ["m."], ["bender", ":"], ["58:57"], ["yeah", "."], ["this"], ["one"], ["here"], ["where"], ["they"], ["crush"], ["all"], ["of"], ["these--"], ["alex"], ["hanna", ":"], ["59:00"], ["where"], ["they"], ["crush"], ["all"], ["the"], ["instrument", "?"], ["emily"], ["m."], ["bender", ":"], ["59:02"], ["--art"], ["tool"], ["and", ","], ["yeah", "."], ["alex"], ["hanna", ":"], ["59:03"], ["yeah", "."], ["I"], ["think"], ["we", "have"], ["talk"], ["about"], ["this", "."], ["and"], ["so", ","], ["I"], ["mean", ","], ["yeah", "."], ["so"], ["I"], ["think"], ["the", ","], ["like", ","], ["the"], ["analysis", "be"], [], ["really"], ["great", "."], ["it", "be"], ["sort"], ["of"], ["like"], ["get"], ["at"], ["it", ","], ["get", ","], ["really"], ["get"], ["at"], ["like", ","], ["who", "be"], ["ask"], ["for"], ["this", "?"], ["why"], ["do"], ["we"], ["have"], ["to"], ["kind"], ["of"], ["bend"], ["ourselves"], ["for"], ["this"], ["product"], ["that"], ["no"], ["one", "'s"], ["ask"], ["for", "?"], ["um", ","], ["in", ",", "in"], [], ["a"], ["really"] 
 Lately, a new framework has been creeping into AI boosterism: "harm reduction," or "responsible use." Education technology scholar dr. sava saheli singh joins Alex and Emily to unpack narratives around automation inevitability in the classroom. Spoiler alert: they're not actually "reducing harm" to students at all! An interdisciplinary scholar and filmmaker, sava is currently working on a research project examining secondary school teachers’ experiences of genAI use, and making a film about the future of AI in education. Her speculative short film series on the harms of surveillance technology is available at screeningsurveillance.com . References: "Harm Reduction: A Strategy to Mitigate the Risks of AI" Also referenced: MAIHT3k newsletter, "How to talk about 'AI' without adding to the anthropomorphization" UNESCO "AI competency framework for students" Fresh AI Hell: Hallucination rebranded as "critical confabulation" "Pennsylvania Board of Medicine Alleges Unlawful Practice of Medicine by an AI Chatbot" "Google's smart home AI will be able to use clothing to identify people" "Medicare AI program made them suffer in pain. Now they want answers" "Why do these Castro gay bars have TSA-style face scanners?" "County With 37 Data Centers Asks Schools to 'Conserve Electricity'" Palate cleanser: "Florida AG sues OpenAI, seeks to hold CEO Altman personally liable" Palate cleanser: "Norway imposes near ban on AI in elementary school" Check out future streams on Twitch . Meanwhile, send us any AI Hell you see . Find our book The AI Con here , and MAIHT3k merch here . Subscribe to our newsletter via Buttondown . Follow us! Emily Bluesky: emilymbender.bsky.social Mastodon: dair-community.social/@EmilyMBender Alex Bluesky: alexhanna.bsky.social Mastodon: dair-community.social/@alex Twitter: @alexhanna Music by Toby Menon. Artwork by Naomi Pleasure-Park . Production by Ozzy Llinas Goodman. 
   
 Alex Hanna: Welcome, everyone, to Mystery AI Hype Theater 3000, where we seek catharsis in this age of AI hype. We find the worst of it and pop it with the sharpest needles we can find. Emily M. Bender: Along the way, we learn to always read the footnotes, and each time we think we've reached peak AI hype, the summit of Bullshit Mountain, we discover there's worse to come. I'm Emily M. Bender, professor of linguistics at the University of Washington. Alex Hanna: And I'm Alex Hanna, director of research for the Distributed AI Research Institute. This is episode 82, which we're recording on July 6th of 2026. Our guest this week is dr. sava saheli singh, who's an assistant professor of digital futures and education at York University in Toronto. Emily M. Bender: An interdisciplinary scholar and filmmaker, sava works at the intersection of education, technology, surveillance, speculative futures, critical digital literacy, labor abolition, and research creation. She's currently working on a research project examining secondary school teachers' experiences of gen AI use and making a film about the future of AI in education. Welcome to the show, sava! sava saheli singh: Hi, thank you so much! I'm excited to be here. And I realize every time someone reads out an introduction, I'm like, "I should write it so that it's readable, read-outable rather than just-" Emily M. Bender: What an amazing intersection to be working at, though. This is gonna be really fun. Alex Hanna: Yeah, it's so good. This week, we're diving into the idea of, quote, "responsible AI use" or "harm reduction." I'm a big fan of harm reduction, but that is not a term that makes sense to use about bullshit generators. Emily M. Bender: When people start using these terms, they're often conceding the point that automation is somehow inevitable. So today, we wanted to really dig into the way AI boosters are using these harm reduction arguments, both in general and specifically in the context of education. Alex Hanna: And we're of course going to talk about why automation is not actually, quote, "responsible" or "reducing harm" at all. So let's get into it. Emily M. Bender: So our first artifact is not an education artifact. But we just wanted to have one place where someone was very clearly using and misusing this term. So this comes from something called GARP. Do we know what GARP is? Alex Hanna: The World According to GARP. It's Global Association of Risk Professionals. Emily M. Bender: Okay, there we go. So this is a little bit old, October 27th of 2023, so one year into or 11 months into ChatGPT being out in the world. And the title here is "Harm Reduction: A Strategy to Mitigate the Risks of AI," and it's by Jesús M. Gonzalez and Laura M. Gonzalez. Similar names there, maybe not by accident. So, "AI advancements have brought a lot of benefits to the financial system, but also come with risks. To minimize the impact of negative consequences arising from the use of AI, financial institutions and regulators can mimic a harm reduction approach that's proved successful in the public health sector." So sava, what, do you think of that analogy? sava saheli singh: It's interesting, right? I think one of the things about harm reduction is to first look at what is happening and then figure out what needs doing, and here they're just taking "Let's mimic a harm reduction approach that's proved successful in public health sector." And it's interesting that they're connecting the public health sector to like, I guess this is finance. And it's problematic on so many levels. Like, where to even start? The financial institution is a harm. So it's weird, just like, there's so much to be done before you even start thinking about the harms of AI, AI in the financial kind of context. So it's weird to have them bring this language into that, and we see this a lot. We see it in education, we see it in academia, we see it in research. A lot of language that's being used in communities to do things for communities that come from the communities are then taken and used as "This is the cool new buzzword. Let's apply this to this other thing," right? And you see it a lot in academic research, and it really breaks my heart because I know that people are trying to do good there, but it's just like, you're taking something that's come from a community for that community, and now you're applying it to something that has nothing to do with the community or is already harmful to that community, and then you're trying to do this thing, right? So it always feels like you're taking buzzwords from things that sound good because they are good for the people that came up with them, and then applying it to this thing to make yourself look better in some way, and that's always just so upsetting. Alex Hanna: Yeah. What I think is actually fascinating about this piece- because it's not just a financial firm, but it's a piece that they're doing risk management, and so they're doing things like fraud protection and this is what they say. The first sentence is very helpful to read here, which it says, "The rise of artificial intelligence tools over the past few years has improved modeling performance and has yielded risk management benefits across areas like fraud protection, anti-money laundering, and credit underwriting." And so those are areas which are really fascinating to highlight and to have some discussion of things coming from public health. Especially because, when we talk about harm reduction, is often used in relation to certain communities that are engaging in different behaviors that we know are likely, may have detrimental consequences for them personally. But it puts blame on those people directly for everything that's happening to them, not in the societal elements and the structural elements that have led people into engaging into some of those kind of behaviors. So it's very weird that this is then, harm reduction is then the paradigm being brought into this by these risk management professionals. It's really ironic. Emily M. Bender: Yeah, and we see it, I think, also somewhat in the education context. So we're gonna talk more about "responsible" and "ethical use," like those catchphrases. But the thing that really gets me about it is that when I hear harm reduction, especially in the context of let's say needle exchanges or something along those lines, it really is- it sounds like it anyway- coming from a perspective of someone who's really caring for people who are among the most marginalized in society and saying, "What do we need to do for these people now? And how do we address the most immediate risks so that these people have a chance to experience less adverse consequences of what's going on?" And to use that terminology and analogize, "Okay, we're gonna have safe injection sites or we're gonna have needle exchanges," to "We're going to teach people how to use this ethically," that just doesn't match. It's not the same kind of thing. And it also has this notion of inevitability, right? So if you've got somebody who has substance use disorder, then you can't just say, "Just stop using," right? That's not gonna work. So there is a certain local inevitability there that you have to deal with. But to then just say, "Yeah, gen AI exists and it's great, so it's gonna have to exist and we're gonna have to use it," is not the same thing and it makes me really mad. sava saheli singh: I wanna say also, recently I've, for better or worse, I've put myself on committees and working groups to think through some of this at our university to be like, what are guidelines for AI in teaching and learning and stuff? And I put myself on these committees with the knowledge that I will at some point rage quit, because that's a thing, and I haven't so far. I think I'm making some sort of leeway because I, much like you were saying, Emily, I change the language that they use. And just a side note, Emily, if I start using language that's not accurate, please correct me, because I think it's useful for people to know what are better ways to say certain things. And I do a lot of that work in the documents that I'm working with. Like I make sure that we use the word "product" instead of "tool," for instance, because people often use that term, right? So please, even I, who I consider myself somewhat aware, always slip up and I try to correct myself. So I appreciate if you would correct me because your post was so useful. So do- Emily M. Bender: I will try to do some. I don't want to interrupt you too much, but I do want to just flag what this post is. So this is on our newsletter, and it's something co-authored with Nanna Inie, where we have a bunch of suggestions for rephrasing words to get away from the anthropomorphizing language that is so deep in the discourse, which is like another kind of rephrasing in addition to this, let's not talk about harm reduction or responsible use. So yeah. So you've put yourself on these committees. sava saheli singh: Yeah, and it's interesting to have some of these conversations. Like it's taught me a lot about how to talk to people a little bit, because I think, like I was saying earlier, year one for me, I was rage. In year two, I'm in despair, and in year three, I'm trying to bring people back, right? And when I'm talking to them, I'm sharing what I know about it, or trying to. I think it was wrong of me to assume that we were operating off of the same kind of understanding of some of these things, and I've learned that the hard way. But some of these things, it's in a document we had to put together, whatever, draft report of where our group was at that time, right? And someone puts it together and I'm in there going "Cancel tool, make it product," or whatever. And the language is important. Like one of the places, I had included, written out, what are all the different kinds of harms of these systems, right? And one of my colleagues had put a comment there saying, "These are only highlighting the negatives." And instead of having a purely harm reduction approach to this, we should also talk about how these things can be useful. And I'm just like- I have decided, like I haven't communicated with them, but I've decided to be like, "You know what? That was a great idea. We should have a harm reduction approach to this, and this is what that looks like." But people use that language as though, like, it's meaningless. Like the term to them has become meaningless. Do you understand when you say the words, where we shouldn't use a harm reduction approach- we are educators. We should have a harm reduction approach to everything we do in the academy. And it's wild to me that people cannot see that or do not understand the words that they are using. So it's really words, what do they mean anymore? Emily M. Bender: Yeah. And if you want to reduce harms, you gotta know what the harms are. And I love this comment in the chat from magidin. He says, "To paraphrase War Games, maybe the only responsible AI use is to not use AI." And yeah, so when I'm on these committees- and I'm often not allowed on the committees, because I'm too good at making people uncomfortable, I think. But the thing that I'm always advocating for is: keep refusal on the table as an option. That we cannot start from, "Okay, it's here, how do we use it responsibly?" It has to be possible to say no. sava saheli singh: Absolutely. I think one of the things I've also done, and this was like, I did this and I read your piece and I'm like, "Oh my god, this is perfect." Because the way that they describe the two sides or the two extremes of AI use is, one is it's restrictive and punitive, two, it's permissive, allowing for exploration and innovation. And I'm like, "No, those are not the two poles." The first pole is critically informed rejection. And the other one is uncritical wholesale adoption. Let's be clear about what these two things are, right? So the way that it is framed is very important, and I'm trying to do some of that work in these committees as well. I'm always that guy in the room, and I'm like, "Okay, I will be that guy now." Emily M. Bender: Yeah. Absolutely. Alex Hanna: I think, the history of what harm reduction is and what traditions that comes out of, it's very weird to then import it here without really considering, if you're making that analogy, what is the implications of making that analogy? What are you treating- AI, you're treating quote-unquote "AI" as like, through an addiction framework. And it's like, no, that doesn't seem like the right- like these are things that you purchase at an institutional level. I'm not sure what's happening here. But yeah, I think really good point in highlighting the language and the abuses of language here. Emily M. Bender: Yeah. All right, before we get to the UNESCO thing, this is making me think of one other thing. So my institution has just rolled out our own "AI assistant," in big scare quotes called Purple AI, 'cause purple and gold are our colors. And it's just a wrapper around some other models, but the idea is that any data that we put in from the UW side doesn't go further. And so it is harm reduction in the sense of, the whole point is to limit the liability of the university, 'cause the university is afraid of cases where our data gets improperly shared. But it's not being portrayed that way. It's, "We have our own tool and this is the one you should use," but it's exactly what it is. sava saheli singh: So, I think that's a good point, right? What is the question there is like, harm to whom? Where are you reducing this harm? To whom? And we get that too, like, "This is a closed system where our data is not going anywhere." But I was like, it's already been, right? What do, like, the things that we're doing has already harmed, and so how are we, what are we doing to reduce that? It's- ugh. Emily M. Bender: Yeah. Ugh. All right. So this is, our next artifact is actually a UNESCO report, under the rubric Education 2030. it was published in 2024, and the title of the whole report is "AI Competency Framework for Students." And there's an obnoxious graphic here, with a white femme-presenting person with dark hair sitting cross-legged holding a book open, and behind them is a monitor sitting on top of two books with an absolutely giant pencil about as big as the person's leg. And then there's a robot that is larger than the screen, and then there's little chat boxes, like speech bubbles, where it seems like the person who's probably a student is having a conversation with the robot. sava saheli singh: Is the robot coming out of the screen? Emily M. Bender: It looks like it, doesn't it? Alex Hanna: Yeah. It looks like, I believe the robot is pulling a "Ring," the girl in The Ring where she's emerging from the television. sava saheli singh: Horror. Alex Hanna: Yeah, very horror. And I don't think it's, as keydelk says, I don't think it's a synthetic generated image. I think it's just a really terrible image. So this is a piece, this comes out of UNESCO. And it's worth reading the short summary to say what this is, and then we'll get into the pieces of it. And so, "Short summary: Preparing students to be responsible and creative citizens in the era of AI. Artificial intelligence, AI, is increasingly integral to our lives, necessitating proactive education systems to prepare students to be responsible users and co-creators of AI. Integrating AI learning objectives into official school curricula is crucial for students globally to engage safely and meaningfully with AI." I'm gonna just pause there to get y'all's thoughts. sava saheli singh: Like you were saying earlier, Emily, like there's never the option to not, right? Here they're like, "responsible users," "co-creators of AI." That makes it sound so nice, friendly, useful, like you're co-creating this stuff. And it's just- no, you're not. It's being taken from you- non-consensually, by the way, right? But it's being reframed into this thing where we're working with the system to do a thing. But nothing is being said about the people who had to work before to make the system. Were they working with the system? Were they co-creators? Again, language that is used to obscure so much of what, number one, went into making this stuff, and number two, how we are made to interact with it, right? And so it's like, "AI learning objectives," and forcing it into official school curricula, and engaging safely and meaningfully. It's like, a lot of students that I talk to, once they learn about this, they're like, "We don't want anything to do with this." Like, where is that, right? Emily M. Bender: Yeah, exactly. I was gonna say, thinking about your work on surveillance in ed tech, sava, what does it mean to be safe, right? If these systems are so much surveillance of the students, whose notion of safety is really being applied here? sava saheli singh: That's exactly it, right? It's this weird paternalistic thing, which is like, "I'm going to keep you safe, and my definition of safety is the one that is the most important, because somehow I've made myself an expert on this, and I've not consulted what you need to make you feel safe." And students talk about that, right? Like we have on campus, we've had students talk about how unsafe they feel, especially now since, in the ongoing Palestinian genocide, there are a lot of students who are on our campus who do not feel safe in those ways, right? Their safety has never been given any sort of thought, right? And it's very sad, because when students tell you what they need to feel safe, institutions rarely do that stuff, right? And like we were saying earlier, who is the harm being reduced for? Institutions are very much looking out for themselves. And so when they set the standard for what it looks like, they make it okay for them to surveil students. In the classroom, it's weird. We use something called eClass at York, and often in all of my classes, I show my students the view that I have as an instructor of the thing, right? And the thing is, okay, I've created it. I'm trying to get off of it, but I've created it, and you have the lessons you have every week. You have the readings and everything. And then I show them that where their names are, I can see what time they logged on, how long they were there, what they looked at, whether they did stuff. And it's like, they're always shocked. A lot of them do not know that this is happening, right? They don't know that they're being surveilled in this way. So then how, now they've integrated AI into the system and it's just like, what the hell? Like, when I opened it last month, we got a notice saying, "Oh, now there are these AI tools baked into this, and it's really helpful, and students can do the thing." And you read it, and the only button there is "I acknowledge." I think they've changed some of the wording now, but that's it. You don't have a choice. It's like, they have decided what it's gonna look like and how you're gonna access things. So it's it's really, yeah, it's really not great. Alex Hanna: It reminds me a bit of the point that I know Britt Paris recently had some research around the network of content management systems. Pick your, whatever one, they are just sort of all tied together. And the kind of data gathering that they're doing in the surveillance mechanism, and then they're then adding these third-party vendors to then ingest that and do whatever. And it's becoming even more and more opaque. So it's really, yeah, really absurd stuff. And I wanna point out just this language of co-creation that this document focuses on. So they mention it even twice on this page. There's another sentence here that just says basically the same thing, except they changed the word from "responsible users" to "responsible citizens," I guess to bring in some kind of element of democracy. But yeah, the idea that co-creation is in any kind of meaningful way happening with regards to these technologies and not as if they are just foisted upon us, is really obscuring so much of what's happening, and really frustrating. Emily M. Bender: I want to also get, for this little thing in the circle, it says, "By 2022, only 15 countries had included AI learning objectives in their national curriculum." Ah, '22, before the whole world went mad. On this, in this way. Alex Hanna: What a weird circle. I thought it was like a coffee ring. Emily M. Bender: Yeah, it's a weird graphic. So where are we going with this, Alex? Alex Hanna: So let's go to page 12, 'cause there's a first paragraph here that I want to get into, which is their introduction. So this is chapter one, introduction. "1.1: Why an AI competency framework for students?" So, "The rapid iterations and proliferation of artificial intelligence, AI, across all aspects of life and all sectors are posing new challenges regarding the nature of machine intelligence." What? "The collection and use of personal data, the role of humans and machines in decision-making, and the impact of AI on social and environmental sustainability. It is essential that education systems prepare students not only with the knowledge and skills to use AI, but also with the insight into the potential impact of technology on societies and the environment at large. Given the transformative potential of AI for human societies, it is crucial to equip students with the values, knowledge, and skills needed for the effective use and active co-creation of AI." So there's a lot here to be upset about. It's mixing the kind of, they're like, "Oh, there are these impacts and on society and the environment, but it is, we need to have this co-creative element." And yeah, I'm gonna pause and try to let y'all comment on this too. sava saheli singh: It's really, it's interesting how I read through some of these. I've read multiple types of these kinds of guidelines, and I'm actually working on one, right? And what's really always interesting is like, even in this one paragraph, there's so many contradictions, right? And there's always this notion of, "Oh, we have to look at both sides. We have to allow for both sides. We have to find a balance." I'm like, how do you find a balance between existential threat and annihilation and, "Oh, look, this cute robot that comes out of your TV like the scary lady from-" So it's weird, again, language, and I know that this is your thing, Emily, in some ways, which is just how language is bent and shaped and made into a pretzel to make a certain point. And I think what I'll also say is, when you look at the authors of these things- and this is something that I'm grappling with, right? When we're writing these things, okay, they have me in the room to make those points, which is, you have to let people opt out. You have to include the environmental issues. You have to do this, right? So someone has said, "We have to include that," and then someone else has said, "But we also have to include this other thing." And it's this weird dance between like, who you are will read through these things, and we're trying to tell you it's bad for the environment, by the way, but also, it'll help you do this thing, but it's also gonna destroy- like, climate change is bad. And it's almost like a comedy act, which is just, what are you actually trying to say here? Because none of these things work together, right? And so it's wild. It's again, it's wild to me how people don't read this and be like, "What are you actually saying here?" Emily M. Bender: Yeah. And so frustrating. So yeah, this contradictory, written by committee thing, and the people who are in there saying, "We need to have no as a legitimate answer," the opt-out option are often just like, "Well, and then critics say..." And you're off in this box on the side. And the last sentence here was really getting me. "It is crucial to equip students with the values, knowledge, and skills needed for the effective use and active co-creation of AI." What about the values, knowledge, and skills to say, "Hell no"? That's, again, just not on screen here. And I haven't read this whole document. Alex, did you spot a definition of artificial intelligence anywhere here? Alex Hanna: No. There's definitely not, no. No definition. There's not a lot of definitions of many things here. In the beginning, this also talks about ethics, it talks about sustainability, and really doesn't go into what any of those really mean. What sustainability? What environmental cost, motherfucker? What are you talking about? Like, are you actually gonna define that? I'm thinking of the goose chase meme. What are you actually referring to, when you're saying this? And what do you mean by ethical? And I think it's such a, there's a lot of hand-waving here, in terms of this. And the intention of this is to provide a bit of a framework of competency, of navigating this to do this with enough sufficient warning, but what does that even entail? And it's really, it's a frustrating document, as many of these types of UN, and other international NGO documents are. But at the same time, shouldn't you define this to some degree? What are we actually getting into? Emily M. Bender: Yeah. There's a comment here from ElizabethwithaZ that I love. "The idea that we should be putting these products in the hands of students and saying, 'Make sure not to do racism with the racism machine' is bonkers." sava saheli singh: Right? So many of these documents, like when you were talking about only 15 countries have done whatever- when they do that thing, it's almost setting you up for FOMO. Which is, hang on, are you a school that hasn't done this? Have you not prepared your students to be like good co-creators, good little co-creators with the AI, of the AI, right? And so many of these documents do that. And I think it's interesting, because a lot of people are working on these guidelines documents now, and how many years out from ChatGPT are we, right? And we have learned so much more about how it works, and so people are trying to bring this "responsible" kind of use of this stuff. And I was talking to my sister earlier, and she was like, "That's like saying 'Smoke responsibly.'" And so you know- and we have, right? A lot of people or critics have made the connections, or the comparisons to the tobacco industry and to smoking in terms of AI, right? What are you doing here? There is no responsible use for this. And even when cigarettes first came out, they were touted as a medical kind of thing, that was gonna help you for various things. And then we learned, and we stopped, right? And we can stop now. We're learning. Alex Hanna: Yeah, absolutely. There's some other elements of this that are pretty bad. So on page 14- Emily M. Bender: Yeah, shall I read it? Alex Hanna: Yeah, go ahead. Emily M. Bender: So, "Section 2.1: Fostering a critical approach to AI." Somehow I don't think that's what this is gonna be. All right. "Critical thinking is a fundamental skill that students need to meaningfully engage with AI as learners, users, and creators. Students also have the responsibility to determine what types of AI should be developed and how they should be used to drive human societies towards inclusive, environmentally sound, shared futures. School students need to be supported to become active co-creators of AI, as well as potential leaders who will define further iterations of AI and its interactions with human society for the present and future generations." I can't with this. Like, it's just, there's- "No" is just absolutely not on the table here, right? "What types of AI should be developed? AI that will drive societies towards inclusive, environmentally sound shared futures." And also, it's this responsibilization, like, individual students should be doing this, when this is all happening because of the massive centralization of wealth and power, where it's being imposed on everyone. Alex Hanna: I also wanna bring in, I don't know, sava, if you've had a chance to read the new Canadian AI, whatever it's called. I don't- sava saheli singh: A little bit. Let's say yes. Alex Hanna: Yeah. It's the Canadian AI strategy, and it's, literally the main title is "AI for All." Which, first, very funny that you took Fei-Fei Li's weird nonprofit and used the same name. That also has many problems, but that's for a different episode. But then the kind of element of that national strategy document is like, "We need to get people involved in the process and upskill them to then get them to get involved with the creation of this technology." And yeah, just what you're saying, Emily, the idea that there is meaningful development of any of the people involved in this, rather than something that is just foisted upon them, is such a weird rhetorical move that's so consistent with this document and so many other documents from large institutions. And so, yeah, I'd love your thoughts on that and anything else, sava. sava saheli singh: It's weird, right? again, a lot of this is framed, like the sentence, "Students also have the responsibility to determine what types of AI should be developed and how they should be used." It's like, there's nothing saying that, number one, which students? Number two, if the students do this, look at all of this and follow the, quote-unquote, "ethical frameworks" that you're setting out and they decide that this is not a good thing, do you then allow students to have that voice to say no? There's nothing that's actually setting students up to be empowered to make the right choices once they learn what these systems are. And so that's a lie right there, right? Like they're assuming that students are gonna be like, "Oh my god, this is so great. Let's do it!" You know what I mean? And in the ways that it has been hyped to be done, everyone's told them that this is gonna change everything for the better. And once they start learning that it's not really, number one, it's not really that great. Everything is so mid, everything that comes out of things like ChatGPT, just really, right? And there are students who recognize that. I have students in my classes who are like, "Thank you, sava, for saying don't do this, or that this is bad, because we hate it. We don't want our students to use it. We can see our brains deteriorating as we use it." So it's not that young people are unaware, right? Again, these kinds of documents have that really, "We know what's best for you," and then we're gonna use language that pretends to empower you to make your decisions, but then we're gonna ignore your decision anyway, right? And that's like- that's what it feels like here. And the Canadian stuff is weird because the Canadian kind of push is just, "We need to make Canadian AI, and that's somehow going to be better than the American AI." And it's like, dudes, it's the same thing. There's really not that much difference between Canada and the US, I'll be honest. There really isn't. I've lived in both places for long enough. I came, I moved to Canada, I'm like, "Oh, yay, Canada." I'm like, "Oh, no, you're the same, if not worse in different ways." And to do this whole nationalistic thing about "Canadian AI is going to save us, because we're just gonna make more pipelines in the meantime, just ignore that part," right? So it's really wild. And it's really upsetting because- it's upsetting but not unexpected- that the politicians and the people in power are gonna say, "We wanna hear from you." And then when we do tell them, they're not actually hearing from us, right? Who are they hearing from? Who gets to have meetings with the Prime Minister of Canada? Who gets to have meetings with those people? We don't, right? Only people with money do. And so they're just setting all of those things, and they're creating a Canadian version of the American setting. And then one day those two things are gonna be married anyway because Canada and America cannot exist without each other. They share everything. They share data, they share surveillance, all of it, right? So to pretend like this is gonna be some separate, better thing, is just such a lie. Emily M. Bender: It'll say sorry when it surveils you. Alex Hanna: The Canadian element of it, it's like, "Well, it's gonna reflect Canadian values." And so just like other types of things in Canada, they make some gesture towards First Nations, and then they say something about truth and reconciliation, and then they don't do anything about it. But then that's actually integrating people and listening to, making Canadian AI. But I don't, I'm taking us a little far afield from this, yeah. Emily M. Bender: Sava, you clocked how in this it says, it's taking this attitude of, "We know best. Here's what you should do." And this isn't written on the basis of actual expertise, right? This is written, it sounds like somebody who got wowed by the tech companies, and that's how they know best, is that these are the people with the money. They're the successful people. We want students to be successful, so we are going to pass through and put the UNESCO imprimatur on these ideas that are actually just coming from the people selling the products. Which, yeah. So I just wanted to ask if you wanted to do the cover going on in the chat, which is hilarious. Alex Hanna: Oh, no, I don't know what it refers to, so if you wanted to- Emily M. Bender: Oh, so I can't sing well enough, but- Alex Hanna: What is it referring to? Sorry, I can't- Emily M. Bender: "I'm not enjoying this cover of 'I Believe the Children Are Our Future,'" and the next line is something like, "Teach them well and let them lead the way." It's an '80s song. And I just can't sing, so I can't produce it for you. But- sava saheli singh: I know the song well. I remember it, and they all sang it together and everything. It was just like, oh my god. Yeah. Emily M. Bender: And then sjaylett says, "At least it's not, 'I believe the thousandth generation are our future.'" But it gets even better, because Oedipvs says, "Slop them well and let them vibe the way? Show them all the tokens they possess inside?" So, anyway, for the entertainment of our Gen X listeners. Alex Hanna: Sorry, this is one of the cases I'm gonna be like, "I missed this." At first I thought it was an Evanescence riff, which it was like, "Slop me up, slop me up inside." But anyways, and I apologize to all the millennials on that are listening. I wanna read one thing here, and then let's go to